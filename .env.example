# Copy this file to .env (the .env file is git-ignored, never commit it).
# Vite only reads it when "npm run dev" starts, so restart after editing.

# true = use the in-browser mock server (no backend needed). Use false once the real API is live.
VITE_USE_MOCK=true

# Backend address, no trailing slash. Only used when VITE_USE_MOCK=false.
VITE_API_URL=http://localhost:3000
